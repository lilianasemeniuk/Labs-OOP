<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="Lab2" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" Background="#d6d0d0"/>

            <MenuItem Header="Objects" Background="#d6d0d0">
                <MenuItem Header="Point" Background="#d6d0d0" Click="MenuItem_Click"/>
                <MenuItem Header="Line" Background="#d6d0d0" Click="MenuItem_Click_1"/>
                <MenuItem Header="Rectangle" Background="#d6d0d0" Click="MenuItem_Click_2"/>
                <MenuItem Header="Ellipse" Background="#d6d0d0" Click="MenuItem_Click_3"/>
            </MenuItem>

            <MenuItem Header="Help" Background="#d6d0d0"/>
        </Menu>

        <Canvas x:Name="MyCanvas" 
                Background="Transparent"
                MouseLeftButtonDown="MyCanvas_MouseLeftButtonDown"
                MouseMove="MyCanvas_MouseMove"
                MouseLeftButtonUp="MyCanvas_MouseLeftButtonUp"
                />
    </DockPanel>
</Window>
