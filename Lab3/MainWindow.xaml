<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="Lab2" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" Background="#d6d0d0">
                <MenuItem Header="Clear" Click="Clear_Click"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Objects" Background="#d6d0d0" SubmenuOpened="ObjectMenu_SubmenuOpened">
                <MenuItem x:Name="MenuPoint" Header="Point" Background="#d6d0d0" Click="MenuItem_Click"/>
                <MenuItem x:Name="MenuLine" Header="Line" Background="#d6d0d0" Click="MenuItem_Click_1"/>
                <MenuItem x:Name="MenuRectangle" Header="Rectangle" Background="#d6d0d0" Click="MenuItem_Click_2"/>
                <MenuItem x:Name="MenuEllipse" Header="Ellipse" Background="#d6d0d0" Click="MenuItem_Click_3"/>
            </MenuItem>

            <MenuItem Header="Help" Background="#d6d0d0" >
                <MenuItem Header="About" Click="Help_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Background="#e0e0e0">
                <Button Click="MenuItem_Click" ToolTip="Point">
                    <Ellipse Width="6" Height="6" Fill="Black"/>
                </Button>
                <Button Click="MenuItem_Click_1" ToolTip="Line">
                    <Path Data="M 2,14 L 14,2" Stroke="Black" StrokeThickness="2" Width="16" Height="16"/>
                </Button>
                <Button Click="MenuItem_Click_2" ToolTip="Rectangle">
                    <Rectangle Width="14" Height="10" Fill="#FFC0CB" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Button Click="MenuItem_Click_3" ToolTip="Ellipse">
                    <Ellipse Width="14" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"/>
                </Button>    
            </ToolBar>
        </ToolBarTray>

        <Canvas x:Name="MyCanvas" 
                Background="Transparent"
                MouseLeftButtonDown="MyCanvas_MouseLeftButtonDown"
                MouseMove="MyCanvas_MouseMove"
                MouseLeftButtonUp="MyCanvas_MouseLeftButtonUp"
                />
    </DockPanel>
</Window>
