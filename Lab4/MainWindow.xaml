<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4"
        mc:Ignorable="d"
        Title="Lab2" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" Background="#d6d0d0">
                <MenuItem Header="Clear" Click="Clear_Click"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Objects" Background="#d6d0d0" SubmenuOpened="ObjectMenu_SubmenuOpened">
                <MenuItem  Header="Point" Background="#d6d0d0" Click="MenuItem_Click" Tag="Point"/>
                <MenuItem  Header="Line" Background="#d6d0d0" Click="MenuItem_Click" Tag="Line"/>
                <MenuItem  Header="Rectangle" Background="#d6d0d0" Click="MenuItem_Click" Tag="Rectangle"/>
                <MenuItem  Header="Ellipse" Background="#d6d0d0" Click="MenuItem_Click" Tag="Ellipse"/>
                <MenuItem  Header="Line with circles" Background="#d6d0d0" Click="MenuItem_Click" Tag="LineWithCircles"/>
                <MenuItem  Header="Cube" Background="#d6d0d0" Click="MenuItem_Click" Tag="Cube"/>
            </MenuItem>

            <MenuItem Header="Help" Background="#d6d0d0" >
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Background="#e0e0e0">
                <Button Click="MenuItem_Click" Tag="Point" ToolTip="Point">
                    <Ellipse Width="6" Height="6" Fill="Black"/>
                </Button>
                <Button Click="MenuItem_Click" Tag="Line" ToolTip="Line">
                    <Path Data="M 2,14 L 14,2" Stroke="Black" StrokeThickness="2" Width="16" Height="16"/>
                </Button>
                <Button Click="MenuItem_Click" Tag="Rectangle" ToolTip="Rectangle">
                    <Rectangle Width="14" Height="10" Fill="#FFC0CB" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Button Click="MenuItem_Click" Tag="Ellipse" ToolTip="Ellipse">
                    <Ellipse Width="14" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Button Click="MenuItem_Click" Tag="LineWithCircles" ToolTip="Лінія з кружечками">
                    <Canvas Width="16" Height="16">
                        <Line X1="2" Y1="14" X2="14" Y2="2" Stroke="Black" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="0" Canvas.Top="12" Width="4" Height="4" Fill="Black"/>
                        <Ellipse Canvas.Left="12" Canvas.Top="0" Width="4" Height="4" Fill="Black"/>
                    </Canvas>
                </Button>
                <Button Click="MenuItem_Click" Tag="Cube" ToolTip="Куб">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="1" Canvas.Top="5" Width="10" Height="10" Stroke="Black" StrokeThickness="1"/>
                        <Rectangle Canvas.Left="5" Canvas.Top="1" Width="10" Height="10" Stroke="Black" StrokeThickness="1"/>
                        <Line X1="1" Y1="5" X2="5" Y2="1" Stroke="Black" StrokeThickness="1"/>
                        <Line X1="11" Y1="5" X2="15" Y2="1" Stroke="Black" StrokeThickness="1"/>
                        <Line X1="1" Y1="15" X2="5" Y2="11" Stroke="Black" StrokeThickness="1"/>
                        <Line X1="11" Y1="15" X2="15" Y2="11" Stroke="Black" StrokeThickness="1"/>
                    </Canvas>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Canvas x:Name="MyCanvas" 
                Background="Transparent"
                MouseLeftButtonDown="MyCanvas_MouseDown"
                MouseMove="MyCanvas_MouseMove"
                MouseLeftButtonUp="MyCanvas_MouseUp"
                />
    </DockPanel>
</Window>
