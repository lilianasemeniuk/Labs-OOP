<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1"
        mc:Ignorable="d"
        Title="Lab1" Height="450" Width="1000" WindowStyle="ThreeDBorderWindow">

    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="15" Background="#bdbcb9" Padding="5">
            <MenuItem Header="Робота 1" Click="MenuItemWork1_Click"/>
            <MenuItem Header="Робота 2" Click="MenuItemWork2_Click"/>
        </Menu>

        <Grid Background="#f0eeeb">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Результат виконання"
                           FontSize="15"
                           Foreground="Black"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="TxtResult"
                           Text="Оберіть пункт меню для початку роботи"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2a2a30"
                           HorizontalAlignment="Center"
                           Margin="0, 10, 0, 0" />
            </StackPanel>
        </Grid>  
    </DockPanel>            
        
</Window>
