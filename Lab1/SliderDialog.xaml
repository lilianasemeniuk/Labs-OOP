<local:BaseDialogWindow x:Class="Lab1.SliderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lab1"
        Title="Робота 1 — Вибір значення" 
        Height="250" 
        Width="400" 
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Оберіть число за допомогою повзунка"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Margin="0, 0, 0, 15"/>

        <Slider x:Name="Slider"
                Minimum="1"
                Maximum="100"
                Value="50"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="SliderValueChanged"
                Margin="0, 0, 0, 15" RenderTransformOrigin="0.497,0.528"/>

        <TextBlock x:Name="TxtValue"
                   Text="50"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#232324"
                   HorizontalAlignment="Center"
                   Margin="0, 0, 0, 10"/>

        <Button Content="Зберегти та закрити"
                Click="BtnOK_Click"
                Height="30"
                Width="200"
                Background="#d2d4d6"
                Foreground="White"
                FontSize="15"
                FontWeight="Bold"
            />



    </StackPanel>
</local:BaseDialogWindow>
