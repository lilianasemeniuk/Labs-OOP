<Window x:Class="Lab5.MyTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Objects Table" Height="350" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ObjectsGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="ObjectsGrid_SelectionChanged"
                  PreviewKeyDown="ObjectsGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="x1" Binding="{Binding X1}" Width="60"/>
                <DataGridTextColumn Header="y1" Binding="{Binding Y1}" Width="60"/>
                <DataGridTextColumn Header="x2" Binding="{Binding X2}" Width="60"/>
                <DataGridTextColumn Header="y2" Binding="{Binding Y2}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Delete selected object"
                Grid.Row="1"
                Margin="0, 10, 0, 0"
                Padding="8,4"
                Click="DeleteButton_Click" />
    </Grid>
</Window>
